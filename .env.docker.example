# Copy to .env.docker (ignored). Fill both secrets with private generated values.
# Use only this file with: docker compose --env-file .env.docker ...
DOCKER_SECRET_KEY=
DOCKER_DB_PASSWORD=

# Non-secret defaults. These are separate from the existing local .env values.
DOCKER_DB_NAME=smart_energy_db
DOCKER_DB_USER=smart_energy
DOCKER_TEST_DB_NAME=test_smart_energy_docker
DOCKER_BACKEND_PORT=8000
