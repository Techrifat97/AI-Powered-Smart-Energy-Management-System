classDiagram
    direction LR

    %% --- Alert detection: abstract class, inheritance, polymorphism, composition ---
    class AlertRule {
      <<abstract>>
      +alert_type: str
      +per_meter: bool
      +applies_to(meter) bool
      +evaluate(building, meter, now)* Finding
    }
    class PowerSeriesRule {
      <<abstract>>
      +applies_to(meter) bool
      +power_series(meter, now) pandas.Series
    }
    class PeakSpikeRule {
      +evaluate(building, meter, now) Finding
    }
    class NightLoadRule {
      +evaluate(building, meter, now) Finding
    }
    class MeterOfflineRule {
      +evaluate(building, meter, now) Finding
    }
    class DailyBudgetRule {
      +evaluate(building, meter, now) Finding
    }
    class Finding {
      <<dataclass>>
      +severity: str
      +message: str
      +value: float
      +threshold: float
    }
    class AlertDetector {
      +rules: list~AlertRule~
      +detect(building, now) list~EnergyAlert~
    }

    AlertRule <|-- PowerSeriesRule
    AlertRule <|-- MeterOfflineRule
    AlertRule <|-- DailyBudgetRule
    PowerSeriesRule <|-- PeakSpikeRule
    PowerSeriesRule <|-- NightLoadRule
    AlertDetector o-- "1..*" AlertRule : composed of
    AlertRule ..> Finding : returns
    AlertDetector ..> EnergyAlert : creates

    %% --- Cost explanation (OpenAI with rule-based fallback) ---
    class CostExplainer {
      <<abstract>>
      +source: str
      +explain(facts)* str
    }
    class OpenAICostExplainer {
      +model: str
      +from_environment()$ OpenAICostExplainer
      +explain(facts) str
    }
    class RuleBasedCostExplainer {
      +explain(facts) str
    }
    class ExplainService {
      <<service>>
      +build_cost_facts(building) dict
      +explain_costs(building, explainers) dict
    }
    CostExplainer <|-- OpenAICostExplainer
    CostExplainer <|-- RuleBasedCostExplainer
    ExplainService o-- "1..*" CostExplainer : tries in order
    OpenAICostExplainer ..> ExplanationUnavailable : raises

    %% --- Exceptions ---
    class AnalysisError {
      <<exception>>
    }
    class ReportUnavailable {
      <<exception>>
      +reason: str
    }
    class ExplanationUnavailable {
      <<exception>>
    }
    Exception <|-- AnalysisError
    AnalysisError <|-- ReportUnavailable
    AnalysisError <|-- ExplanationUnavailable

    %% --- Persistent models ---
    class TariffPlan {
      +name: str
      +rate_standard_eur_per_kwh: float
      +rate_peak_eur_per_kwh: float
      +peak_start_hour: int
      +peak_end_hour: int
      +solar_feed_in_eur_per_kwh: float
      +is_active: bool
    }
    class EnergyAlert {
      +severity: str
      +alert_type: str
      +message: str
      +value_recorded: float
      +threshold_value: float
      +is_resolved: bool
    }
    class CostReport {
      +period_start: date
      +period_end: date
      +total_grid_kwh: float
      +total_cost_eur: float
      +solar_savings_eur: float
    }
    class Building {
      <<S1 monitoring>>
    }
    class Meter {
      <<S1 monitoring>>
    }

    Building "1" --> "*" EnergyAlert
    Meter "0..1" --> "*" EnergyAlert
    Building "1" --> "*" CostReport
    TariffPlan "1" --> "*" CostReport : priced with

    %% --- Service functions (Decimal money calculations) ---
    class CostAnalysis {
      <<service>>
      +cost_analysis(building, start, end) dict
    }
    class ScenarioService {
      <<service>>
      +latest_complete_period(building) tuple
      +run_scenario(building, tariff, consumption_change_pct, solar_change_pct, period) dict
    }
    class ReportService {
      <<service>>
      +generate_cost_report(building, start, end) CostReport
    }
    ScenarioService ..> CostAnalysis : reuses interval pricing
    ReportService ..> CostAnalysis : uses
    ReportService ..> CostReport : creates
    ReportService ..> ReportUnavailable : raises
    ExplainService ..> CostAnalysis : facts
    ExplainService ..> ScenarioService : 10% saving tip
    CostAnalysis ..> TariffPlan : reads active
    ScenarioService ..> TariffPlan : baseline + optional alternative
