# Django Settings
SECRET_KEY=django-insecure-smart-energy-management-2026-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Set USE_SQLITE=True for local development/testing without PostgreSQL server
# Set USE_SQLITE=False when PostgreSQL is running locally
USE_SQLITE=True
DB_ENGINE=django.db.backends.postgresql
DB_NAME=smart_energy_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# OpenAI API Configuration (S2 Coach Subsystem)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
