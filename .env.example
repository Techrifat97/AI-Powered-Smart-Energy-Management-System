# Django Settings
SECRET_KEY=replace-with-a-local-development-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL is required. Set the password in your ignored local .env file.
DB_NAME=smart_energy_db
DB_USER=smart_energy_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# Must start with test_ and differ from DB_NAME. Django creates/drops this database.
DB_TEST_NAME=test_smart_energy_db

# OpenAI API Configuration (S2 Coach Subsystem)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
